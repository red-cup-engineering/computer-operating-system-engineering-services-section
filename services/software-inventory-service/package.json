{
  "name": "@red-cup-engineering/software-inventory-service",
  "version": "0.0.6",
  "description": "Inventories a bounded software territory as addressed filesystem, package, Git, deployment, and systemd observations.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-operating-system-engineering-services-section.git",
    "directory": "services/software-inventory-service"
  },
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "import": "./src/software-inventory.mjs"
    },
    "./source-drift": {
      "import": "./src/source-drift.mjs"
    }
  },
  "bin": {
    "inventory-software": "./scripts/inventory-software.mjs",
    "observe-source-drift": "./scripts/observe-source-drift.mjs"
  },
  "files": [
    "scripts/",
    "schemas/",
    "src/",
    "types/",
    "MIGRATION.md"
  ],
  "scripts": {
    "inventory": "node scripts/inventory-software.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@red-cup-engineering/computer-code-development-engine": "workspace:*",
    "@red-cup-engineering/computer-code-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-data-engineering-services-section": "workspace:*",
    "@red-cup-engineering/computer-filepath-engineering-services-section": "workspace:*",
    "@red-cup-engineering/disk-package-observation-app": "workspace:*",
    "@red-cup-engineering/git-services-section": "workspace:*",
    "@red-cup-engineering/javascript-node-services-section": "workspace:*",
    "@red-cup-engineering/json-schema-services-section": "workspace:*",
    "@red-cup-engineering/metrologic": "workspace:*",
    "@red-cup-engineering/npm-package-tree-discovery-service": "workspace:*",
    "@red-cup-engineering/systemd-unit-inventory-observation-service": "workspace:*",
    "@red-cup-engineering/uri-services-section": "workspace:*",
    "@red-cup-engineering/computer-content-address-engineering-services-section": "workspace:*"
  }
}

{
  "name": "@red-cup-engineering/replacing-file-content-service",
  "version": "0.1.0",
  "type": "module",
  "description": "Replaces a literal string in one text file using an atomic write.",
  "bin": {
    "replace-file-content": "./scripts/replace-file-content.mjs"
  },

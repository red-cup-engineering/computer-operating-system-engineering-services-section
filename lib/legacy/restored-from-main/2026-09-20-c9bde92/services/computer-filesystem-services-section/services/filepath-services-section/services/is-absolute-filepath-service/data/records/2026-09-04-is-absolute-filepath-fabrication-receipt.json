{"type":"MarkdownJsnodeOperationPackageFabricationReceipt","version":1,"sourceDigest":"sha256:60d2cc1a52edc04eaefd4d0c85c2f46f11e890c9e73db051f3d40219e1b7a80b","specificationDigest":"sha256:3f158386f5838add895365c26c4176e83d7ddfc5785dfde26f43a440a3d51d93","artifactSpecification":{"type":"ArtifactFabricationSpecification","version":1,"source":{"type":"ArtifactFabricationSource","version":1,"identity":{"type":"ArtifactFabricationSourceIdentity","id":"is-absolute-filepath"},"provenance":{"type":"ArtifactFabricationSourceProvenance","locator":"/tmp/claude-1000/-home-emsenn-info/c47c4faf-5aba-4a06-b95b-6aeb98ff98db/scratchpad/wo/is-absolute-filepath.md","digest":"sha256:60d2cc1a52edc04eaefd4d0c85c2f46f11e890c9e73db051f3d40219e1b7a80b","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":1,"endLine":63}}},"artifact":{"type":"FabricatedArtifactIdentity","version":1,"id":"is-absolute-filepath","kind":"jsnode-operation-package"},"requirements":[{"type":"ArtifactFabricationRequirement","version":1,"id":"absoluteness-reported","statement":"The operation returns true exactly when node:path isAbsolute does for the spelling.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":3,"endLine":3}}],"prohibitions":[{"type":"ArtifactFabricationProhibition","version":1,"id":"non-string-refusal","statement":"The operation must refuse a request that is not a string.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":5,"endLine":5}}],"openQuestions":[],"constraints":[{"type":"ArtifactFabricationConstraint","version":1,"id":"fabricate-do-not-hand-write","kind":"law","authority":"561 Group working discipline, dispatch-agents skill","revision":"2026-09-04","locator":".claude/skills/dispatch-agents/SKILL.md","applicability":"Applies to the imports of every new script and source module in the tree.","statement":"A direct Node built-in import where a house service exists is a defect a lot must not ship; this service is the one house owner of its operation.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":7,"endLine":7}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-path","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/path.html","applicability":"Applies to the path projection.","statement":"The projection is the platform path algebra of node:path, without observing the filesystem.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":9,"endLine":9}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-esm-operation","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/esm.html","applicability":"Applies to the .mjs operation, its import.meta.main guard, and downstream package-birth assays.","statement":"The package uses one executable ESM operation source file that is eligible for downstream staged package-birth assays.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":10,"endLine":10}}],"projections":[{"type":"ArtifactFabricationProjection","version":1,"id":"jsnode-operation-package","target":"@red-cup-engineering/jsnode-operation-package-specification-admission-service","configuration":{"type":"JsnodeOperationPackageSpecificationCandidate","version":1,"packageName":"@red-cup-engineering/is-absolute-filepath-service","packageVersion":"0.1.0","license":"MIT","operation":{"type":"JavascriptNodeOperationSource","path":"scripts/is-absolute-filepath.mjs","text":"#!/usr/bin/env node\nimport { isAbsolute } from \"node:path\";\n\n/**\n * Reports whether one filepath spelling is absolute on this platform, without observing the filesystem.\n * @param {string} path A filepath spelling.\n * @returns {boolean} Whether the spelling is absolute.\n * @throws {TypeError} When path is not a string.\n */\nexport function isAbsoluteFilepath(path) {\n  if (typeof path !== \"string\") throw new TypeError(\"a filepath string is required\");\n  return isAbsolute(path);\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"isAbsoluteFilepath — Reports whether one filepath spelling is absolute on this platform, without observing the filesystem.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(await isAbsoluteFilepath(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"},"tests":[{"type":"JavascriptNodeOperationTestSource","path":"test/is-absolute-filepath.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { isAbsoluteFilepath } from \"../scripts/is-absolute-filepath.mjs\";\ntest(\"reports absoluteness\", () => {\n  assert.equal(isAbsoluteFilepath(\"/x/y\"), true);\n  assert.equal(isAbsoluteFilepath(\"x/y\"), false);\n  assert.equal(isAbsoluteFilepath(\"\"), false);\n});\ntest(\"refuses a non-string\", () => assert.throws(() => isAbsoluteFilepath(null), /a filepath string is required/u));\n"}],"examples":[{"type":"JavascriptNodeOperationExample","name":"is-absolute-filepath example","input":"/x/y","output":true}],"dependencies":{},"devDependencies":{}},"sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":14,"endLine":60}}],"acceptanceObligations":[{"type":"ArtifactFabricationAcceptanceObligation","version":1,"id":"jsnode-package-assays","kind":"assay","statement":"The existing JSNode package-birth pipeline must admit, stage, test, pack, install, and assay the projected package.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":46,"endLine":60}}],"traceability":[{"type":"ArtifactFabricationTrace","version":1,"requirementId":"absoluteness-reported","constraintIds":["fabricate-do-not-hand-write","node-esm-operation"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]},{"type":"ArtifactFabricationTrace","ve
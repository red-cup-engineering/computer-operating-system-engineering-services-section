{"type":"MarkdownJsnodeOperationPackageFabricationReceipt","version":1,"sourceDigest":"sha256:e806e710a28f341846222aa96ea5754c28efbdb0c0be5a7fd7b642701752ae77","specificationDigest":"sha256:dd9ff0eea7768bf130e041bd3c59d820b7731f2c25933a7e609f889a654fdb4a","artifactSpecification":{"type":"ArtifactFabricationSpecification","version":1,"source":{"type":"ArtifactFabricationSource","version":1,"identity":{"type":"ArtifactFabricationSourceIdentity","id":"project-file-url-filepath"},"provenance":{"type":"ArtifactFabricationSourceProvenance","locator":"/tmp/claude-1000/-home-emsenn-info/c47c4faf-5aba-4a06-b95b-6aeb98ff98db/scratchpad/project-file-url-filepath.md","digest":"sha256:e806e710a28f341846222aa96ea5754c28efbdb0c0be5a7fd7b642701752ae77","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":1,"endLine":65}}},"artifact":{"type":"FabricatedArtifactIdentity","version":1,"id":"project-file-url-filepath","kind":"jsnode-operation-package"},"requirements":[{"type":"ArtifactFabricationRequirement","version":1,"id":"file-url-to-filepath","statement":"The operation projects one file: URL spelling, such as a module's import.meta.url, to the platform filepath it names, decoding percent-escapes.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":3,"endLine":3}}],"prohibitions":[{"type":"ArtifactFabricationProhibition","version":1,"id":"non-file-url-refusal","statement":"The operation must refuse a request that is not a string beginning with file:.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":5,"endLine":5}}],"openQuestions":[],"constraints":[{"type":"ArtifactFabricationConstraint","version":1,"id":"fabricate-do-not-hand-write","kind":"law","authority":"561 Group working discipline, dispatch-agents skill","revision":"2026-09-04","locator":".claude/skills/dispatch-agents/SKILL.md","applicability":"Applies to the imports of every new script and source module in the tree.","statement":"A direct node:url import where a house service exists is a defect a lot must not ship; this service is the one house owner of the file-URL-to-path projection.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":7,"endLine":7}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-url-file-url-to-path","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/url.html#urlfileurltopathurl-options","applicability":"Applies to the projection of a WHATWG file: URL to a platform path.","statement":"The projection decodes percent-escapes and rejects non-file: URLs exactly as url.fileURLToPath does.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":9,"endLine":9}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-esm-operation","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/esm.html","applicability":"Applies to the .mjs operation, its import.meta.main guard, and downstream package-birth assays.","statement":"The package uses one executable ESM operation source file that is eligible for downstream staged package-birth assays.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":10,"endLine":10}}],"projections":[{"type":"ArtifactFabricationProjection","version":1,"id":"jsnode-operation-package","target":"@red-cup-engineering/jsnode-operation-package-specification-admission-service","configuration":{"type":"JsnodeOperationPackageSpecificationCandidate","version":1,"packageName":"@red-cup-engineering/project-file-url-filepath-service","packageVersion":"0.1.0","license":"MIT","operation":{"type":"JavascriptNodeOperationSource","path":"scripts/project-file-url-filepath.mjs","text":"#!/usr/bin/env node\nimport { fileURLToPath } from \"node:url\";\n\n/**\n * Projects one file: URL spelling, such as a module's import.meta.url, to the platform filepath it names.\n * @param {string} url A file: URL string.\n * @returns {string} The platform filepath the URL names.\n * @throws {TypeError} When url is not a string beginning with file:.\n */\nexport function projectFileUrlFilepath(url) {\n  if (typeof url !== \"string\" || !url.startsWith(\"file:\")) throw new TypeError(\"a file: URL string is required\");\n  return fileURLToPath(url);\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"projectFileUrlFilepath — Projects one file: URL spelling, such as a module's import.meta.url, to the platform filepath it names.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(projectFileUrlFilepath(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"},"tests":[{"type":"JavascriptNodeOperationTestSource","path":"test/project-file-url-filepath.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { projectFileUrlFilepath } from \"../scripts/project-file-url-filepath.mjs\";\ntest(\"projects a file URL to its filepath, decoding escapes\", () => {\n  assert.equal(projectFileUrlFilepath(\"file:///tmp/a%20b/c.mjs\"), \"/tmp/a b/c.mjs\");\n});\ntest(\"projects a module's own import.meta.url\", () => {\n  assert.ok(projectFileUrlFilepath(import.meta.url).endsWith(\"/test/project-file-url-filepath.test.mjs\"));\n});\ntest(\"refuses a non-file URL\", () => assert.throws(() => projectFileUrlFilepath(\"https://example.org/x\"), /a file: URL string is required/u));\ntest(\"refuses a non-string\", () => assert.throws(() => projectFileUrlFilepath(42), /a file: URL string is required/u));\n"}],"examples":[{"type":"JavascriptNodeOperationExample","name":"projects a file URL","input":"file:///tmp/a%20b/c.mjs","output":"/tmp/a b/c.mjs"}],"dependencies":{},"devDependencies":{}},"sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":14,"endLine":62}}],"acceptanceObligations":[{"type":"ArtifactFabricationAcceptanceObligation","version":1,"id":"jsnode-package-assays","kind":"assay","statement":"The existing JSNode package-birth pipeline must admit, stage, test, pack, install, and assay the projected package.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":46,"endLine":62}}],"traceability":[{"type":"ArtifactFabricationTrace","version":1,"requirementId":"file-url-to-filepath","constraintIds":["fabricate-do-not-hand-write","node-esm-operation","node-url-file-url-to-path"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]},{"type":"ArtifactFabricationTrace","version":1,"requirementId":"non-file-url-refusal","constraintIds":["fabricate-do-not-hand-write","node-esm-operation","node-url-file-url-to-path"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]}],"specificationDigest":"sha256:dd9ff0eea7768bf130e041bd3c59d820b7731f2c25933a7e609f889a654fdb4a"},"jsnodeOperationPackageCreationReceipt":{"type":"JsnodeOperationPackageCreationReceipt","version":1,"packageName":"@red-cup-engineering/project-file-url-filepath-service","packageVersion":"0.1.0","destination":"/home/emsenn/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-operating-system-services-section/services/computer-filesystem-services-section/services/filepath-services-section/services/project-file-url-filepath-service","filesDigest":"sha256:971ed93ee88ac7bf228d91b0b1ebc92b23e5399dd7d079b640f04cbe26adbe58","files":[{"type":"TextFileMaterialization","version":1,"path":"package.json","mode":420,"digest":"sha256:7220f6e389cd3c782fe60bab76051fa3b600fcd0d30aa31ca3adc90f48b4ba8d"},{"type":"TextFileMaterialization","version":1,"path":"README.md","mode":420,"digest":"sha256:02958dcf5c9f96a190fbb215b6436e1a76a628e0c5318e49c7655ab71b905b10"},{"type":"TextFileMaterialization","versi
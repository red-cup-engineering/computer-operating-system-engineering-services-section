{"type":"MarkdownJsnodeOperationPackageFabricationReceipt","version":1,"sourceDigest":"sha256:de1751138b09135fc4efe6d59677b319ef9960bb18f545805bce62a4c571f301","specificationDigest":"sha256:dca523afcd7700c5993039d2e0c9fa383ad82f0c33df2878b11e037023d8f739","artifactSpecification":{"type":"ArtifactFabricationSpecification","version":1,"source":{"type":"ArtifactFabricationSource","version":1,"identity":{"type":"ArtifactFabricationSourceIdentity","id":"project-filepath-extension"},"provenance":{"type":"ArtifactFabricationSourceProvenance","locator":"/tmp/claude-1000/-home-emsenn-info/c47c4faf-5aba-4a06-b95b-6aeb98ff98db/scratchpad/wo/project-filepath-extension.md","digest":"sha256:de1751138b09135fc4efe6d59677b319ef9960bb18f545805bce62a4c571f301","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":1,"endLine":63}}},"artifact":{"type":"FabricatedArtifactIdentity","version":1,"id":"project-filepath-extension","kind":"jsnode-operation-package"},"requirements":[{"type":"ArtifactFabricationRequirement","version":1,"id":"extension-projected","statement":"The operation returns the extension of the last path component including its leading dot, exactly as node:path extname does, and the empty string when there is none.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":3,"endLine":3}}],"prohibitions":[{"type":"ArtifactFabricationProhibition","version":1,"id":"non-string-refusal","statement":"The operation must refuse a request that is not a string.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":5,"endLine":5}}],"openQuestions":[],"constraints":[{"type":"ArtifactFabricationConstraint","version":1,"id":"fabricate-do-not-hand-write","kind":"law","authority":"561 Group working discipline, dispatch-agents skill","revision":"2026-09-04","locator":".claude/skills/dispatch-agents/SKILL.md","applicability":"Applies to the imports of every new script and source module in the tree.","statement":"A direct Node built-in import where a house service exists is a defect a lot must not ship; this service is the one house owner of its operation.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":7,"endLine":7}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-path","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/path.html","applicability":"Applies to the path projection.","statement":"The projection is the platform path algebra of node:path, without observing the filesystem.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":9,"endLine":9}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-esm-operation","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/esm.html","applicability":"Applies to the .mjs operation, its import.meta.main guard, and downstream package-birth assays.","statement":"The package uses one executable ESM operation source file that is eligible for downstream staged package-birth assays.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":10,"endLine":10}}],"projections":[{"type":"ArtifactFabricationProjection","version":1,"id":"jsnode-operation-package","target":"@red-cup-engineering/jsnode-operation-package-specification-admission-service","configuration":{"type":"JsnodeOperationPackageSpecificationCandidate","version":1,"packageName":"@red-cup-engineering/project-filepath-extension-service","packageVersion":"0.1.0","license":"MIT","operation":{"type":"JavascriptNodeOperationSource","path":"scripts/project-filepath-extension.mjs","text":"#!/usr/bin/env node\nimport { extname } from \"node:path\";\n\n/**\n * Projects one filepath spelling to its final extension, including the dot, or the empty string when it has none, without observing the filesystem.\n * @param {string} path A filepath spelling.\n * @returns {string} The extension including its dot, or the empty string.\n * @throws {TypeError} When path is not a string.\n */\nexport function projectFilepathExtension(path) {\n  if (typeof path !== \"string\") throw new TypeError(\"a filepath string is required\");\n  return extname(path);\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"projectFilepathExtension — Projects one filepath spelling to its final extension, including the dot, or the empty string when it has none, without observing the filesystem.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(await projectFilepathExtension(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"},"tests":[{"type":"JavascriptNodeOperationTestSource","path":"test/project-filepath-extension.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { projectFilepathExtension } from \"../scripts/project-filepath-extension.mjs\";\ntest(\"projects the final extension\", () => {\n  assert.equal(projectFilepathExtension(\"a/b.tar.gz\"), \".gz\");\n  assert.equal(projectFilepathExtension(\"a/b\"), \"\");\n  assert.equal(projectFilepathExtension(\".hidden\"), \"\");\n});\ntest(\"refuses a non-string\", () => assert.throws(() => projectFilepathExtension(1), /a filepath string is required/u));\n"}],"examples":[{"type":"JavascriptNodeOperationExample","name":"project-filepath-extension example","input":"a/b.tar.gz","output":".gz"}],"dependencies":{},"devDependencies":{}},"sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":14,"endLine":60}}],"acceptanceObligations":[{"type":"ArtifactFabricationAcceptanceObligation","version":1,"id":"jsnode-package-assays","kind":"assay","statement":"The existing JSNode package-birth pipeline must admit, stage, test, pack, install, and assay the projected package.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":46,"endLine":60}}],"trac
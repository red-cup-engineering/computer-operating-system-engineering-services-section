{"type":"MarkdownJsnodeOperationPackageFabricationReceipt","version":1,"sourceDigest":"sha256:ee37166fd4b97f05c7dd060bef792287618409f24562789bf8bccb34155f1835","specificationDigest":"sha256:c843820c103ee9325ad0397c7e087567ce022a4db9ab6c72966fba62285c208d","artifactSpecification":{"type":"ArtifactFabricationSpecification","version":1,"source":{"type":"ArtifactFabricationSource","version":1,"identity":{"type":"ArtifactFabricationSourceIdentity","id":"relate-filepath"},"provenance":{"type":"ArtifactFabricationSourceProvenance","locator":"/tmp/claude-1000/-home-emsenn-info/c47c4faf-5aba-4a06-b95b-6aeb98ff98db/scratchpad/wo/relate-filepath.md","digest":"sha256:ee37166fd4b97f05c7dd060bef792287618409f24562789bf8bccb34155f1835","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":1,"endLine":62}}},"artifact":{"type":"FabricatedArtifactIdentity","version":1,"id":"relate-filepath","kind":"jsnode-operation-package"},"requirements":[{"type":"ArtifactFabricationRequirement","version":1,"id":"relation-projected","statement":"The operation returns the relative path from the from spelling to the to spelling exactly as node:path relative does.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":3,"endLine":3}}],"prohibitions":[{"type":"ArtifactFabricationProhibition","version":1,"id":"missing-endpoints-refusal","statement":"The operation must refuse a request whose from or to is not a string.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":5,"endLine":5}}],"openQuestions":[],"constraints":[{"type":"ArtifactFabricationConstraint","version":1,"id":"fabricate-do-not-hand-write","kind":"law","authority":"561 Group working discipline, dispatch-agents skill","revision":"2026-09-04","locator":".claude/skills/dispatch-agents/SKILL.md","applicability":"Applies to the imports of every new script and source module in the tree.","statement":"A direct Node built-in import where a house service exists is a defect a lot must not ship; this service is the one house owner of its operation.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":7,"endLine":7}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-path","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/path.html","applicability":"Applies to the path projection.","statement":"The projection is the platform path algebra of node:path, without observing the filesystem.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":9,"endLine":9}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-esm-operation","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/esm.html","applicability":"Applies to the .mjs operation, its import.meta.main guard, and downstream package-birth assays.","statement":"The package uses one executable ESM operation source file that is eligible for downstream staged package-birth assays.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":10,"endLine":10}}],"projections":[{"type":"ArtifactFabricationProjection","version":1,"id":"jsnode-operation-package","target":"@red-cup-engineering/jsnode-operation-package-specification-admission-service","configuration":{"type":"JsnodeOperationPackageSpecificationCandidate","version":1,"packageName":"@red-cup-engineering/relate-filepath-service","packageVersion":"0.1.0","license":"MIT","operation":{"type":"JavascriptNodeOperationSource","path":"scripts/relate-filepath.mjs","text":"#!/usr/bin/env node\nimport { relative } from \"node:path\";\n\n/**\n * Projects the relative filepath spelling from one path to another, without observing the filesystem.\n * @param {object} request A record with from and to filepath spellings.\n * @returns {string} The relative path from from to to.\n * @throws {TypeError} When from or to is not a string.\n */\nexport function relateFilepath(request) {\n  if (typeof request?.from !== \"string\" || typeof request?.to !== \"string\") throw new TypeError(\"from and to filepath strings are required\");\n  return relative(request.from, request.to);\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"relateFilepath — Projects the relative filepath spelling from one path to another, without observing the filesystem.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(await relateFilepath(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"},"tests":[{"type":"JavascriptNodeOperationTestSource","path":"test/relate-filepath.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { relateFilepath } from \"../scripts/relate-filepath.mjs\";\ntest(\"relates two paths\", () => {\n  assert.equal(relateFilepath({ from: \"/a/b\", to: \"/a/c/d\" }), \"../c/d\");\n  assert.equal(relateFilepath({ from: \"/a\", to: \"/a\" }), \"\");\n});\ntest(\"refuses missing endpoints\", () => assert.throws(() => relateFilepath({ from: \"/a\" }), /from and to filepath strings are required/u));\n"}],"examples":[{"type":"JavascriptNodeOperationExample","name":"relate-filepath example","input":{"from":"/a/b","to":"/a/c/d"},"output":"../c/d"}],"dependencies":{},"devDependencies":{}},"sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":14,"endLine":59}}],"acceptanceObligations":[{"type":"ArtifactFabricationAcceptanceObligation","version":1,"id":"jsnode-package-assays","kind":"assay","statement":"The existing JSNode package-birth pipeline must admit, stage, test, pack, install, and assay the projected package.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":46,"endLine":59}}],"traceability":[{"type":"ArtifactFabricationTrace","version":1,"requirementId":"relation-projected","constraintIds":["fabricate-do-not-hand-write","node-esm-operation"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]},{"type":"ArtifactFabricationTrace","version":1,"requirementId":"missing-endpoints-refusal","constraintIds":["fabricate-do-not-hand-write","node-esm-operation"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]}],"specificationDigest":"sha256:c843820c103ee9325ad0397c7e087567ce022a4db9ab6c72966fba62285c208d"},"jsnodeOperationPackageCreationReceipt":{"type":"JsnodeOperationPackageCreationReceipt","version":1,"packageName":"@red-cup-engineering/relate-filepath-service","packageVersion":"0.1.0","destination":"/home/emsenn/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-operating-system-services-section/services/computer-filesystem-services-section/services/filepath-services-section/services/relate-filepath-service","filesDigest":"sha256:e1652af8feca42b4cb95a0f08de8fc842b03ad9f3ded2f82c6ee4e1f2909788d","files":[{"type":"TextFileMaterialization","version":1,"path":"package.json","mode":420,"digest":"sha256:98879bf306c3e8262ad72994a2ab9fea1b01741723e5aa19579f7461aa0845e9"},{"type":"TextFileMaterialization","version":1,"path":"README.md","mode":420,"digest":"sha256:5ed42d2bd7b83422d263beca2cf5cc367d1f9dca7cf0da1057f6092d201612aa"},{"type":"TextFileMaterialization","version":1,"path":"scripts/relate-filepath.mjs","mode":493,"digest":"sha256:67ec953be03d1305486b1b2dde5af530a91bfecbda810a9812fb6b529140db37"},{"type":"TextFileMaterialization","version":1,"path":"test/relate-filepath-faces.test.mjs","mode":420,"digest":"sha256:bd3c2eae7eaab05437c5596f595e372796d7138722c869e8ea32a0d2a4d77711"},{"type":"TextFileMaterialization","version":1,"path":"test/relate-filepath.test.mjs","mode":420,"digest":"sha256:5364e8485e678b81d4a94791a5334fc11f0edfc7bb5a21cf64a557609891a94f"}],"assays":[{"type":"J
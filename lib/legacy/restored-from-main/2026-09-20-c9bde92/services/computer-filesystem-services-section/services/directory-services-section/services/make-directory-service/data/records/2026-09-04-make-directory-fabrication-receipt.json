{"type":"MarkdownJsnodeOperationPackageFabricationReceipt","version":1,"sourceDigest":"sha256:35f2d394913e243d93153e953c31d888628b6822484b60cf5a959c06ad5c0d33","specificationDigest":"sha256:6abadb8c92b0c22dd7c352ca0145043dcd01d9487e84f93fdceeab03f927f5be","artifactSpecification":{"type":"ArtifactFabricationSpecification","version":1,"source":{"type":"ArtifactFabricationSource","version":1,"identity":{"type":"ArtifactFabricationSourceIdentity","id":"make-directory"},"provenance":{"type":"ArtifactFabricationSourceProvenance","locator":"/tmp/claude-1000/-home-emsenn-info/c47c4faf-5aba-4a06-b95b-6aeb98ff98db/scratchpad/wo/make-directory.md","digest":"sha256:35f2d394913e243d93153e953c31d888628b6822484b60cf5a959c06ad5c0d33","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":1,"endLine":68}}},"artifact":{"type":"FabricatedArtifactIdentity","version":1,"id":"make-directory","kind":"jsnode-operation-package"},"requirements":[{"type":"ArtifactFabricationRequirement","version":1,"id":"directory-made","statement":"The operation makes the directory at the given path with every missing ancestor and returns a DirectoryMade record naming the path; an existing directory is not an error.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":3,"endLine":3}}],"prohibitions":[{"type":"ArtifactFabricationProhibition","version":1,"id":"missing-path-refusal","statement":"The operation must refuse a request whose path is not a non-empty string.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":5,"endLine":5}}],"openQuestions":[],"constraints":[{"type":"ArtifactFabricationConstraint","version":1,"id":"fabricate-do-not-hand-write","kind":"law","authority":"561 Group working discipline, dispatch-agents skill","revision":"2026-09-04","locator":".claude/skills/dispatch-agents/SKILL.md","applicability":"Applies to the imports of every new script and source module in the tree.","statement":"A direct Node built-in import where a house service exists is a defect a lot must not ship; this service is the one house owner of its operation.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":7,"endLine":7}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-fs-promises","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/fs.html#promises-api","applicability":"Applies to the filesystem effect.","statement":"The operation performs exactly one filesystem effect through the fs promises API.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":9,"endLine":9}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-esm-operation","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/esm.html","applicability":"Applies to the .mjs operation, its import.meta.main guard, and downstream package-birth assays.","statement":"The package uses one executable ESM operation source file that is eligible for downstream staged package-birth assays.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":10,"endLine":10}}],"projections":[{"type":"ArtifactFabricationProjection","version":1,"id":"jsnode-operation-package","target":"@red-cup-engineering/jsnode-operation-package-specification-admission-service","configuration":{"type":"JsnodeOperationPackageSpecificationCandidate","version":1,"packageName":"@red-cup-engineering/make-directory-service","packageVersion":"0.1.0","license":"MIT","operation":{"type":"JavascriptNodeOperationSource","path":"scripts/make-directory.mjs","text":"#!/usr/bin/env node\nimport { mkdir } from \"node:fs/promises\";\n\n/**\n * Makes one directory and every missing ancestor, and reports the path made.\n * @param {object} request A record with the directory path.\n * @returns {Promise<object>} A DirectoryMade record.\n * @throws {TypeError} When path is not a non-empty string.\n */\nexport async function makeDirectory(request) {\n  if (typeof request?.path !== \"string\" || request.path.length === 0) throw new TypeError(\"a non-empty path is required\");\n  await mkdir(request.path, { recursive: true });\n  return { type: \"DirectoryMade\", path: request.path };\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"makeDirectory — Makes one directory and every missing ancestor, and reports the path made.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(await makeDirectory(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"},"tests":[{"type":"JavascriptNodeOperationTestSource","path":"test/make-directory.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { makeDirectory } from \"../scripts/make-directory.mjs\";\nimport { tmpdir } from \"node:os\";\nimport { stat, rm } from \"node:fs/promises\";\ntest(\"makes nested directories and tolerates existing ones\", async () => {\n  const path = `${tmpdir()}/561-make-directory-test-${process.pid}/a/b`;\n  assert.deepEqual(await makeDirectory({ path }), { type: \"DirectoryMade\", path });\n  assert.ok((await stat(path)).isDirectory());\n  assert.deepEqual(await makeDirectory({ path }), { type: \"DirectoryMade\", path });\n  await rm(`${tmpdir()}/561-make-directory-test-${process.pid}`, { recursive: true, force: true });\n});\ntest(\"refuses a missing path\", async () => { await assert.rejects(() => makeDirectory({}), /a non-empty path is required/u); });\n"}],"examples":[{"type":"JavascriptNodeOperationExample","name":"make-directory example","input":{"path":"/tmp/561-group-make-directory-example"},"output":{"type":"DirectoryMade","path":"/tmp/561-group-make-directory-example"}}],"dependencies":{},"devDependencies":{}},"sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":14,"endLine":65}}],"acceptanceObligations":[{"t
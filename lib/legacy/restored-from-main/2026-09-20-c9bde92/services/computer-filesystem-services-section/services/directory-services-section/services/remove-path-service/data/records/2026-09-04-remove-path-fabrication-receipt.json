{"type":"MarkdownJsnodeOperationPackageFabricationReceipt","version":1,"sourceDigest":"sha256:affcac01d499a653cd56cfad2c0669073078cccad235cac81554556203e7d158","specificationDigest":"sha256:d779bf2dd655e4295548687c607dde86a2b7a2b00eaafba271e2bda5480715b3","artifactSpecification":{"type":"ArtifactFabricationSpecification","version":1,"source":{"type":"ArtifactFabricationSource","version":1,"identity":{"type":"ArtifactFabricationSourceIdentity","id":"remove-path"},"provenance":{"type":"ArtifactFabricationSourceProvenance","locator":"/tmp/claude-1000/-home-emsenn-info/c47c4faf-5aba-4a06-b95b-6aeb98ff98db/scratchpad/wo/remove-path.md","digest":"sha256:affcac01d499a653cd56cfad2c0669073078cccad235cac81554556203e7d158","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":1,"endLine":69}}},"artifact":{"type":"FabricatedArtifactIdentity","version":1,"id":"remove-path","kind":"jsnode-operation-package"},"requirements":[{"type":"ArtifactFabricationRequirement","version":1,"id":"path-removed","statement":"The operation removes the file or directory tree at the given path, recursively and without error when absent, and returns a PathRemoved record naming the path.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":3,"endLine":3}}],"prohibitions":[{"type":"ArtifactFabricationProhibition","version":1,"id":"missing-path-refusal","statement":"The operation must refuse a request whose path is not a non-empty string.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":5,"endLine":5}}],"openQuestions":[],"constraints":[{"type":"ArtifactFabricationConstraint","version":1,"id":"fabricate-do-not-hand-write","kind":"law","authority":"561 Group working discipline, dispatch-agents skill","revision":"2026-09-04","locator":".claude/skills/dispatch-agents/SKILL.md","applicability":"Applies to the imports of every new script and source module in the tree.","statement":"A direct Node built-in import where a house service exists is a defect a lot must not ship; this service is the one house owner of its operation.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":7,"endLine":7}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-fs-promises","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/fs.html#promises-api","applicability":"Applies to the filesystem effect.","statement":"The operation performs exactly one filesystem effect through the fs promises API.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":9,"endLine":9}},{"type":"ArtifactFabricationConstraint","version":1,"id":"node-esm-operation","kind":"standard","authority":"Node.js","revision":"v24.2.0+","locator":"https://nodejs.org/docs/v24/api/esm.html","applicability":"Applies to the .mjs operation, its import.meta.main guard, and downstream package-birth assays.","statement":"The package uses one executable ESM operation source file that is eligible for downstream staged package-birth assays.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":10,"endLine":10}}],"projections":[{"type":"ArtifactFabricationProjection","version":1,"id":"jsnode-operation-package","target":"@red-cup-engineering/jsnode-operation-package-specification-admission-service","configuration":{"type":"JsnodeOperationPackageSpecificationCandidate","version":1,"packageName":"@red-cup-engineering/remove-path-service","packageVersion":"0.1.0","license":"MIT","operation":{"type":"JavascriptNodeOperationSource","path":"scripts/remove-path.mjs","text":"#!/usr/bin/env node\nimport { rm } from \"node:fs/promises\";\n\n/**\n * Removes one file or directory tree at a path, and reports the path removed; an absent path is not an error.\n * @param {object} request A record with the path to remove.\n * @returns {Promise<object>} A PathRemoved record.\n * @throws {TypeError} When path is not a non-empty string.\n */\nexport async function removePath(request) {\n  if (typeof request?.path !== \"string\" || request.path.length === 0) throw new TypeError(\"a non-empty path is required\");\n  await rm(request.path, { recursive: true, force: true });\n  return { type: \"PathRemoved\", path: request.path };\n}\n\nif (import.meta.main) {\n  if (process.argv.includes(\"--help\")) {\n    process.stdout.write(\"removePath — Removes one file or directory tree at a path, and reports the path removed; an absent path is not an error.\\n\");\n  } else {\n    let text = \"\";\n    for await (const chunk of process.stdin) text += chunk;\n    for (const line of text.split(\"\\n\")) {\n      if (line.length > 0) process.stdout.write(`${JSON.stringify(await removePath(JSON.parse(line)))}\\n`);\n    }\n  }\n}\n"},"tests":[{"type":"JavascriptNodeOperationTestSource","path":"test/remove-path.test.mjs","text":"import assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { removePath } from \"../scripts/remove-path.mjs\";\nimport { tmpdir } from \"node:os\";\nimport { mkdir, writeFile, access } from \"node:fs/promises\";\ntest(\"removes a directory tree and tolerates an absent path\", async () => {\n  const root = `${tmpdir()}/561-remove-path-test-${process.pid}`;\n  await mkdir(`${root}/a`, { recursive: true });\n  await writeFile(`${root}/a/f.txt`, \"x\");\n  assert.deepEqual(await removePath({ path: root }), { type: \"PathRemoved\", path: root });\n  await assert.rejects(() => access(root));\n  assert.deepEqual(await removePath({ path: root }), { type: \"PathRemoved\", path: root });\n});\ntest(\"refuses a missing path\", async () => { await assert.rejects(() => removePath({ path: \"\" }), /a non-empty path is required/u); });\n"}],"examples":[{"type":"JavascriptNodeOperationExample","name":"remove-path example","input":{"path":"/tmp/561-group-remove-path-example-absent"},"output":{"type":"PathRemoved","path":"/tmp/561-group-remove-path-example-absent"}}],"dependencies":{},"devDependencies":{}},"sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":14,"endLine":66}}],"acceptanceObligations":[{"type":"ArtifactFabricationAcceptanceObligation","version":1,"id":"jsnode-package-assays","kind":"assay","statement":"The existing JSNode package-birth pipeline must admit, stage, test, pack, install, and assay the projected package.","sourceSpan":{"type":"ArtifactFabricationSourceSpan","startLine":47,"endLine":66}}],"traceability":[{"type":"ArtifactFabricationTrace","version":1,"requirementId":"path-removed","constraintIds":["fabricate-do-not-hand-write","node-esm-operation"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]},{"type":"ArtifactFabricationTrace","version":1,"requirementId":"missing-path-refusal","constraintIds":["fabricate-do-not-hand-write","node-esm-operation"],"projectionIds":["jsnode-operation-package"],"acceptanceObligationIds":["jsnode-package-assays"]}],"specificationDigest":"sha256:d779bf2dd655e4295548687c607dde86a2b7a2b00eaafba271e2bda5480715b3"},"jsnodeOperationPackageCreationReceipt":{"type":"JsnodeOperationPackageCreationReceipt","version":1,"packageName":"@red-cup-engineering/remove-path-service","packageVersion":"0.1.0","destination":"/home/emsenn/info/lib/emsenn/services/561-group/services/engineering-services-section/services/computer-engineering-services-section/services/computer-systems-engineering-services-section/services/computer-operating-system-services-section/services/computer-filesystem-services-section/services/directory-services-section/services/remove-path-service","filesDigest":"sha256:6964af270d9c2f2d00c4df9add3ed41aac159cccdd54a0cf907eb2d535c05031","files":[{"type":"TextFileMaterialization","version":1,"path":"package.json","mode":420,"digest":"sha256:6070bd58155b3ed391a448b84adda0ad4946237153dd51597253597791417e01"},{"type":"TextFileMaterialization","version":1,"path":"README.md","mode":420,"digest":"sha256:2ced35f84176112d328a5486e1d2dd95887c2839f25340739fd2caf26212fbd3"},{"type":"TextFileMaterialization","version":1,"pat